# Copy to .env for local testing (vercel dev reads it). Never commit .env.
# Three predefined recipients, comma separated
RECIPIENTS=first@example.com,second@example.com,third@example.com

# 1 = only print the email in the terminal, do not send (safe local testing)
DRY_RUN=1

# SMTP (e.g. Zoho: smtp.zoho.com or smtppro.zoho.com / smtp.zoho.in, port 465)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=petition@yourdomain.com
SMTP_PASS=your-app-password
# Optional display name for the sender
MAIL_FROM="KPFA Petition <petition@yourdomain.com>"
